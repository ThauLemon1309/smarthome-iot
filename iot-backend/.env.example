# ========== ADAFRUIT IO CLOUD ONLY ==========
# Copy file này thành .env và điền giá trị thực

# Adafruit IO
ADAFRUIT_IO_KEY=your_adafruit_io_key_here
ADAFRUIT_IO_USERNAME=your_adafruit_username
ADAFRUIT_API_URL=https://io.adafruit.com/api/v2

# Server
PORT=3000
NODE_ENV=development

# Database (SQL Server)
DB_SERVER=YOUR_PC_NAME
DB_INSTANCE=SQLEXPRESS
DB_DATABASE=DADN
DB_USER=your_sql_user
DB_PASSWORD=your_sql_password
